# Copy this file to .env and fill it in. See "Running locally" in README.md.

# Replace with a long random string, e.g. the output of
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Required. Locally a SQLite file, which Flask keeps in instance/dev.db
DATABASE_URL=sqlite:///dev.db
# The Postgres schema every table lives in; only used in production
SCHEMA=flask_schema

# Only song uploads need S3; see "S3 credentials" in CONTRIBUTING.md
S3_BUCKET=yours3bucket
S3_KEY=yours3key
S3_SECRET=yours3secretkey

# Google OAuth - leave blank to hide the "Continue with Google" buttons.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when Flask cannot infer its own public URL, e.g. while running the
# React dev server on port 3000 in front of Flask on port 5000
GOOGLE_REDIRECT_URI=
